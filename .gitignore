# Rust
/target
**/*.rs.bk
Cargo.lock.bak

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
/android/captures/
/android/.cxx/
/android/.kotlin/
*.iml

# Signing: never commit a real keystore; debug.keystore stays allowed
# (generated by AGP, not secret).
*.keystore
!debug.keystore
*.jks
keystore.properties
/keystores/

# Generated bindings (regenerated on each build)
/android/app/src/main/jniLibs/

# Certs / keys / bundles — NEVER committed. The repository only contains
# tests that generate their PKI on the fly with rcgen.
*.p12
*.pfx
*.pem
*.crt
*.key
*.csr
*.cer
*.der
backend-ca.*
mtls_bridge-bundle*.zip
mtls_bridge-backup*.zip
mtls-bridge-bundle*.zip
bundles/

# Secrets / env
*.local.*
.env
.env.*
secrets.properties
secrets/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp
*.swo
*.bak
