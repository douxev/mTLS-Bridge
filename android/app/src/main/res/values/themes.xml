<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Minimal XML theme: all visuals go through Compose Material3.
         No dependency on Material Components for Android (XML library), to stay
         lightweight. The Theme.Material.Light.NoActionBar parent is part of the
         Android framework. -->
    <style name="Theme.Mtlswrap" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
