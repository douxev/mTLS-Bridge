<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Loopback network: INTERNET is not needed for 127.0.0.1, but it is
         needed for the upstream side of the proxy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 (API 37): access to RFC 1918 / link-local / CGNAT
         upstreams. Runtime permission of the "Nearby devices" group,
         requested only if the upstream host resolves to a local address
         (see runtime/LocalNetworkAccess.kt). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Loopback proxy: no dedicated FGS type fits a local network proxy,
         hence specialUse (justification declared on the <service>). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- VpnService: the FGS types documentation reserves systemExempted for
         "VPN apps" (VpnService.prepare() consent granted). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Notifications (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Restart active proxies at boot (TV: frequent restarts, Jellyfin
         launched from the home screen without opening mTLS Bridge). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- A single APK for phone + Android TV / Google TV: leanback and
         touchscreen are optional, otherwise the Play Store does not offer the
         app on TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <!-- To list launchable apps in the AddConfig picker and resolve their
             UID (getApplicationInfo). Without this, Android 11+ filters
             PackageManager results; QUERY_ALL_PACKAGES is not needed. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Android TV-only apps (e.g. org.jellyfin.androidtv): they only
             expose LEANBACK_LAUNCHER and would otherwise be invisible. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MtlsApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mtlswrap">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mtlswrap"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Android TV / Google TV home screen. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Loopback proxy: specialUse ForegroundService. The property value
             is reviewed by Google Play on submission. -->
        <service
            android:name=".service.LoopbackProxyService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local mTLS proxy: listens on 127.0.0.1 for one app chosen by the user and forwards its HTTP requests over mutual TLS to a self-hosted server, signing with a client key kept in Android Keystore. Must keep running while that app is in use; started and stopped explicitly by the user." />
        </service>

        <!-- VPN service: BIND_VPN_SERVICE permission granted by the OS on the
             first user consent via VpnService.prepare().
             Lint only knows the "exact alarm" criteria of systemExempted; the
             FGS types documentation also lists "VPN apps" there (VPN consent
             granted), which is our case. -->
        <service
            android:name=".service.MtlsVpnService"
            android:foregroundServiceType="systemExempted"
            tools:ignore="ForegroundServicePermission"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Not exported: can only be triggered by our own PendingIntents from
             the foreground notifications. -->
        <receiver
            android:name=".service.ProxyStopReceiver"
            android:exported="false" />

        <!-- Exported to receive BOOT_COMPLETED / MY_PACKAGE_REPLACED, two
             protected broadcasts that only the system can send. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
