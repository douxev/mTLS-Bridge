<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Réseau loopback — pas besoin d'INTERNET pour 127.0.0.1, mais on en a
         besoin pour le côté upstream du proxy. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17 (API 37) : accès aux upstreams en RFC 1918 / link-local /
         CGNAT. Permission runtime du groupe « Appareils à proximité »,
         demandée seulement si l'hôte upstream se résout en adresse locale
         (voir runtime/LocalNetworkAccess.kt). -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Proxy loopback : aucun type FGS dédié ne correspond à un proxy réseau
         local → specialUse (justification déclarée sur le <service>). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- VpnService : la doc des types FGS réserve systemExempted aux « VPN apps »
         (consentement VpnService.prepare() accordé). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <!-- Notification (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Relance des proxys actifs au démarrage (TV : redémarrages fréquents,
         Jellyfin lancé depuis l'accueil sans ouvrir mTLS Bridge). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Un seul APK téléphone + Android TV / Google TV : leanback et écran
         tactile optionnels, sinon le Play Store ne propose pas l'app sur TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <queries>
        <!-- Pour lister les apps lanceables dans le picker AddConfig et
             résoudre leur UID (getApplicationInfo). Sans ça, Android 11+ filtre
             les retours de PackageManager ; pas besoin de QUERY_ALL_PACKAGES. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Apps réservées à Android TV (ex. org.jellyfin.androidtv) : elles
             n'exposent que LEANBACK_LAUNCHER et seraient sinon invisibles. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".MtlsApplication"
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mtlswrap">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Mtlswrap"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Écran d'accueil Android TV / Google TV. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Proxy loopback : ForegroundService de type specialUse. La valeur
             de la propriété est relue par Google Play à la soumission. -->
        <service
            android:name=".service.LoopbackProxyService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local mTLS proxy: listens on 127.0.0.1 for one app chosen by the user and forwards its HTTP requests over mutual TLS to a self-hosted server, signing with a client key kept in Android Keystore. Must keep running while that app is in use; started and stopped explicitly by the user." />
        </service>

        <!-- Service VPN : permission BIND_VPN_SERVICE octroyée par l'OS au
             premier consentement utilisateur via VpnService.prepare().
             Lint ne connaît que les critères « alarme exacte » de systemExempted ;
             la doc des types FGS y range aussi les « VPN apps » (consentement
             VPN accordé), notre cas. -->
        <service
            android:name=".service.MtlsVpnService"
            android:foregroundServiceType="systemExempted"
            tools:ignore="ForegroundServicePermission"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <!-- Pas exporté : déclenchable uniquement par nos propres PendingIntent
             depuis les notifications de premier plan. -->
        <receiver
            android:name=".service.ProxyStopReceiver"
            android:exported="false" />

        <!-- Exporté pour recevoir BOOT_COMPLETED / MY_PACKAGE_REPLACED, deux
             broadcasts protégés que seul le système peut émettre. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
