<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Debug uniquement : sur Android 16, la restriction réseau local activée
         via `adb shell am compat enable RESTRICT_LOCAL_NETWORK <pkg>` est
         levée par NEARBY_WIFI_DEVICES (remplacée par ACCESS_LOCAL_NETWORK en
         Android 17). Permet de tester la demande de permission sans
         l'imposer aux builds release. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:maxSdkVersion="36"
        android:usesPermissionFlags="neverForLocation" />
</manifest>
